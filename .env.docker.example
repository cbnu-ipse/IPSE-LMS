# ==========================================
# IPSE LMS — Docker 환경변수 템플릿
# 이 파일을 .env.docker 로 복사한 후 값을 채우세요.
# .env.docker 는 .gitignore에 등록되어 있습니다.
# ==========================================

# Django
SECRET_KEY=your-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,cbnu-ipse.co.kr,.cbnu-ipse.co.kr

# 어드민 페이지 경로 (지정하지 않으면 배포 환경 최초 실행 시 임의의 무작위 문자열이 생성되어 .env에 자동 추가됩니다)
# ADMIN_PATH=ipse-admin-random-path

# PostgreSQL
POSTGRES_DB=ipse_lms
POSTGRES_USER=ipse
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://ipse:change-this-strong-password@db:5432/ipse_lms

# judge(contest/problems) 전용 DB — db_judge 컨테이너 설정은 .env.judge.docker 참고
JUDGE_DATABASE_URL=postgresql://ipse_judge:change-this-strong-password@db_judge:5432/beta_judge

# Email (운영 환경)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@cbnu-ipse.co.kr
EMAIL_TIMEOUT=30
PASSWORD_RESET_TIMEOUT=86400

# ==========================================
# Cloudflare Tunnel
# Zero Trust 대시보드 → Networks → Tunnels → 터널 생성 후 토큰 복사
# https://one.dash.cloudflare.com/
# ==========================================
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
REDIS_URL=redis://redis:6379/0

# AI 공급자 키 — 키가 없는 공급자에 지정된 작업은 OpenAI(MYPAGE_CHAT_MODEL)로 대신 부른다 (키를 넣기 전에는 예전과 동일)
# 기본 배정: 모든 작업 = Gemini (gemini-3.5-flash-lite). 작업별로 아래 변수로 openai·anthropic으로 바꿀 수 있다
# OPENAI_API_KEY=
# GEMINI_API_KEY=            (Google Cloud 콘솔 > Agent Platform > API 키, 'Agent Platform API'로 제한된 키)
# GEMINI_BACKEND=vertex      vertex(기본, Cloud 무료 체험 크레딧 사용 가능) 또는 studio(AI Studio 키, 선불 크레딧 필요)
# ANTHROPIC_API_KEY=
# 작업별 공급자 바꾸기: AI_PROVIDER_<작업>=openai|gemini|anthropic  (예: AI_PROVIDER_SUMMARY=openai)
# AI 작업별 모델 (비우면 코드의 기본 모델 gemini-3.5-flash-lite를 씀)
# AI_MODEL_CHAT=
# AI_MODEL_CHAT_COMPACT=
# AI_MODEL_SUMMARY=
# AI_MODEL_OCR=
# AI_MODEL_QUESTION=
# AI_MODEL_GRADING=
# AI_MODEL_CLASSIFY=
# AI_MODEL_COURSE_READINESS=
# AI_MODEL_COURSE_OUTLINE=
# AI_MODEL_COURSE_CHAPTER=
# AI 사용 비용(크레딧). 크레딧은 보상 코드 등으로 얻는다. 강의자·운영진·관리자는 크레딧 없이 쓴다
# AI_COST_CHAT=1
# AI_COST_SUMMARY=3        # 요약 1조각당
# AI_COST_QUESTION=2
# AI_COST_GRADING=1
# AI_LIMIT_SUMMARY_CHUNK_CHARS=12000
